pkgbase = nuxut-git
	pkgdesc = Nuxut: a desktop shell for Hyprland written in Rust (shell, lock screen, settings, calendar)
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/nuxut/shell
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = clang
	makedepends = pkgconf
	depends = hyprland
	depends = wayland
	depends = libxkbcommon
	depends = xkeyboard-config
	depends = mesa
	depends = libglvnd
	depends = fontconfig
	depends = dbus
	depends = systemd
	depends = pam
	depends = polkit
	depends = pipewire
	depends = wireplumber
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gtk
	depends = ca-certificates
	depends = inter-font
	depends = adobe-source-serif-fonts
	depends = ttf-jetbrains-mono-nerd
	depends = ttf-material-symbols-variable
	optdepends = networkmanager: network section and Wi-Fi/VPN quick settings
	optdepends = bluez: Bluetooth section
	optdepends = upower: battery indicator
	optdepends = power-profiles-daemon: power profile selector
	optdepends = mpv: video wallpapers
	optdepends = grim: screenshots
	optdepends = wl-clipboard: copy screenshots to the clipboard
	optdepends = xdg-utils: open links and files from notifications
	optdepends = noto-fonts-emoji: colour glyphs in the emoji picker
	optdepends = ddcutil: external monitor brightness (DDC/CI udev rule; needs i2c-dev)
	optdepends = vimix-cursors: default cursor theme of the unified look
	optdepends = papirus-icon-theme: default icon theme of the unified look
	optdepends = gnome-keyring: Secret Service for online account tokens (or kwallet)
	provides = nuxut
	conflicts = nuxut
	source = framework::git+https://github.com/nuxut/framework.git
	source = shell::git+https://github.com/nuxut/shell.git
	source = settings::git+https://github.com/nuxut/settings.git
	source = calendar::git+https://github.com/nuxut/calendar.git
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = nuxut-git
